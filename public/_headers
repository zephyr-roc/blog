# Decorative article-cover SVG files should remain usable by pages but should
# not appear as standalone results in search engines.
/covers/*
  X-Robots-Tag: noindex

/zig-logomark.svg
  X-Robots-Tag: noindex


# Hashed build assets are content-addressed and safe to cache permanently.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/favicon.png
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/zig-logomark.svg
  Cache-Control: public, max-age=31536000, immutable

/covers/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
